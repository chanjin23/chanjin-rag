# 저장소 루트에 .env로 복사해서 사용합니다. 실제 .env는 Git에 올리지 않습니다 (TRD 11장, 12.1).
# 키 확인: uv run python scripts/check_nvidia.py
APP_ENV=dev
LOG_LEVEL=INFO
# 앱 로그에 질문 원문을 남길지(운영 false, 개발에서만 true). 꺼져 있으면 길이만 남깁니다 (TRD 11장)
LOG_QUERY_TEXT=false
# 모델 Provider: nvidia(실제 API) | fake(결정적인 가짜 구현, 외부 호출 없음).
# pytest와 E2E는 APP_ENV=test, PROVIDER=fake로 실행되며 이 .env를 읽지 않습니다.
PROVIDER=nvidia

# build.nvidia.com에서 모델마다 발급한 키(nvapi-로 시작). 따옴표 없이 그대로 붙여 넣습니다.
NVIDIA_LLM_API_KEY=
NVIDIA_EMBED_API_KEY=
NVIDIA_RERANK_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# 모델별 추가 요청값(JSON 한 줄). 추론(thinking) 끄는 키가 모델마다 다릅니다.
#   nemotron: {"chat_template_kwargs":{"enable_thinking":false}}
#   deepseek: {"chat_template_kwargs":{"thinking":false}}
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# 답변 설정(TRD 7.1: temperature 0~0.3, max_tokens 1,024~2,048)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# LLM 읽기 타임아웃(초). 무료 엔드포인트는 대기열 때문에 첫 응답까지 1분 넘게 걸리기도 합니다
LLM_READ_TIMEOUT=180
# 임베딩·재정렬 읽기 타임아웃(초)
PROVIDER_READ_TIMEOUT=60
EMBED_MODEL=nvidia/nemotron-3.5-embed-8b
# 모델 기본 출력은 4096차원이라 halfvec HNSW 한도(4000)를 넘으므로 dimensions로 줄여 씁니다 (TRD 6.3)
EMBED_DIM=2048
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
# 재정렬은 OpenAI 호환이 아니라 별도 주소를 씁니다
RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_ENABLED=true
# 질의 전체 시간 상한(초). 넘으면 SSE error(timeout) (TRD 7.3)
CHAT_TIMEOUT_SECONDS=60

EMBED_DAILY_FILE_LIMIT=100
# 0이면 제한 없음
EMBED_DAILY_CHUNK_LIMIT=0
# 수집 허용 최상위 폴더(이 밖과 /project/, /backup/은 받지 않음)
SYNC_ALLOWED_ROOT=C:\Chanjin\dev
# 업로드 원본 임시 보관 폴더. 비우면 저장소의 var/tmp
UPLOAD_TMP_DIR=
# 작업 큐: 재시도 상한, 멈춘 작업으로 보는 시간(분), 429 지속 시 미루는 시간(분), 빈 큐 확인 간격(초)
JOB_MAX_ATTEMPTS=5
JOB_STALE_LOCK_MINUTES=10
JOB_RATE_LIMIT_DELAY_MINUTES=30
WORKER_POLL_SECONDS=5
# 무료 임베딩 엔드포인트는 여러 문장을 묶은 요청에 500을 돌려줘서 1개씩 보냅니다(2026-11-07 실측)
EMBED_BATCH_SIZE=1
# 문서 파서 하위 프로세스의 시간(초)·메모리(MB) 상한. 메모리 0이면 상한 없음
PARSER_TIMEOUT_SECONDS=60
PARSER_MEMORY_LIMIT_MB=1024
# Kiwi 사용자 사전(프로젝트명·고유명사). 비우면 저장소의 deploy/kiwi_user_dict.txt.
# 바꾸면 `backend reindex --bm25`로 다시 색인합니다 (TRD 6.4)
KIWI_USER_DICT_PATH=
LOCAL_DELETED_RETENTION_DAYS=30
MASS_DELETE_GUARD_RATIO=0.2
SYNC_RUN_STALE_MINUTES=10

# 웹 세션 쿠키 Secure 속성. 운영(APP_ENV=prod)은 항상 true. 로컬 HTTP에서만 false로 둡니다 (TRD 11장)
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=14
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# CSRF Origin 검사에서 요청 Host 외에 허용할 출처(쉼표로 구분). 프록시가 Host를 바꿀 때만 씁니다
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
TZ=Asia/Seoul
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_ON_VM=3
# 백업 폴더(비우면 저장소 var/backups). 운영 Compose에서는 backups 볼륨 경로
BACKUP_DIR=
# 외부 명령(JSON 목록). 기본 ["pg_dump"], ["age"]
# BACKUP_PG_DUMP_CMD=["pg_dump"]
# BACKUP_AGE_CMD=["age"]

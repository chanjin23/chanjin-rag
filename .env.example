# 저장소 루트에 .env로 복사해서 사용합니다. 실제 .env는 Git에 올리지 않습니다 (TRD 11장, 12.1).
# 키 확인: uv run python scripts/check_nvidia.py
APP_ENV=dev
LOG_LEVEL=INFO

# build.nvidia.com에서 모델마다 발급한 키(nvapi-로 시작). 따옴표 없이 그대로 붙여 넣습니다.
NVIDIA_LLM_API_KEY=
NVIDIA_EMBED_API_KEY=
NVIDIA_RERANK_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash
# DeepSeek은 답 앞에 영어 추론 텍스트를 내므로 기본으로 끕니다(chat_template_kwargs.thinking=false)
LLM_THINKING=false
EMBED_MODEL=nvidia/nemotron-3.5-embed-8b
# 모델 기본 출력은 4096차원이라 halfvec HNSW 한도(4000)를 넘으므로 dimensions로 줄여 씁니다 (TRD 6.3)
EMBED_DIM=2048
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
# 재정렬은 OpenAI 호환이 아니라 별도 주소를 씁니다
RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_ENABLED=true

EMBED_DAILY_FILE_LIMIT=100
# 무료 임베딩 엔드포인트는 여러 문장을 묶은 요청에 500을 돌려줘서 1개씩 보냅니다(2026-11-07 실측)
EMBED_BATCH_SIZE=1

DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
TZ=Asia/Seoul
BACKUP_AGE_RECIPIENT=
BACKUP_KEEP_ON_VM=3
